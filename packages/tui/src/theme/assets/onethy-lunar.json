    "syntaxNumber": {
      "dark": "paleGold",
      "light": "#D97706"
    },
    "syntaxType": {
      "dark": "starlightIce",
      "light": "#4F46E5"
    },
    "syntaxOperator": {
      "dark": "coralPink",
      "light": "#E11D48"
